{
  "name": "dsh-chatgpt-plus",
  "version": "1.2.0",
  "description": "ChatGPT account sign-in and remaining Codex subscription quota in DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "quota.js",
    "quota-cache.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check quota.js && node --check quota-cache.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
